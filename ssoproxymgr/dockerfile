FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

RUN apk add --no-cache tzdata

COPY ["ssoproxymgr/ssoproxymgr.csproj", "ssoproxymgr/"]
COPY ["ssoproxy/ssoproxy.csproj", "ssoproxy/"]
COPY ["gd/gd.csproj", "gd/"]
RUN dotnet restore "ssoproxymgr/ssoproxymgr.csproj"

COPY ssoproxymgr/ ./ssoproxymgr/
COPY ssoproxy/ ./ssoproxy/
COPY gd/ ./gd/
RUN dotnet publish "ssoproxymgr/ssoproxymgr.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app

RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Taipei /etc/localtime && \
    echo "Asia/Taipei" > /etc/timezone

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "ssoproxymgr.dll"]
