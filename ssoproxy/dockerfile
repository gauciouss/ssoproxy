FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# 安裝 busybox-extras 取得 telnet 工具
RUN apk update && \
    apk add --no-cache busybox-extras

# 先只複製 .csproj，讓 NuGet restore 只在專案檔有更新時才重新執行
COPY ["gd/gd.csproj", "gd/"]
COPY ["ssoproxy/ssoproxy.csproj", "ssoproxy/"]
RUN dotnet restore "ssoproxy/ssoproxy.csproj"

# 複製剩餘原始碼後再進行編譯釋出
COPY gd/ ./gd/
COPY ssoproxy/ ./ssoproxy/
RUN dotnet publish "ssoproxy/ssoproxy.csproj" -c Release -o /app/publish /p:UseAppHost=false

# 部署階段：使用 Alpine 確保最小足跡
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app
COPY --from=build /app/publish .

# 鎖定台灣時區 (GMT+8)
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Taipei /etc/localtime && \
    echo "Asia/Taipei" > /etc/timezone

EXPOSE 80
ENTRYPOINT ["dotnet", "ssoproxy.dll"]