{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwe": {
    "Secret": "sso-development-jwe-secret-32-bytes"
  },
  "ConnectionStrings": {
    "Redis": "redis-master:26379,redis-slave:26379,password=YourStrongPassword,serviceName=mymaster"
  },  
  "SsoWhitelist": [  // 【新增：SSO 免驗證白名單路徑】
    "^/target-web/health$",                 // 1. 完全比對：健康檢查端點
    "^/target-web/public/.*$",              // 2. 字首比對：所有 /public/ 底下的公開頁面
    "\\. (fx|css|js|png|jpg|jpeg|gif|ico)$" // 3. 副檔名比對：放行所有靜態資源
  ],
  "ReverseProxy": {
    "Routes": {
      "test1-route": {
        "ClusterId": "target-web1-cluster",
        "Match": {
          "Hosts": ["test1.gd.com"],
          "Path": "/{**catch-all}"
        }
      },
      "test2-route": {
        "ClusterId": "target-web2-cluster",
        "Match": {
          "Hosts": ["test2.gd.com"],
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "target-web1-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://sso-poc-target-web1/"
          }
        }
      },
      "target-web2-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://sso-poc-target-web2/"
          }
        }
      }
    }
  }
}