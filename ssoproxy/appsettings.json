{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwe": {
    "Secret": "sso-development-jwe-secret-32-bytes"
  },
  "ConnectionStrings": {
    "Redis": "redis-master:26379,redis-slave:26379,password=YourStrongPassword,serviceName=mymaster"
  },  
  "SsoWhitelist": [  // 【新增：SSO 免驗證白名單路徑】
    "^/target-web/health$",                 // 1. 完全比對：健康檢查端點
    "^/target-web/public/.*$",              // 2. 字首比對：所有 /public/ 底下的公開頁面
    "\\. (fx|css|js|png|jpg|jpeg|gif|ico)$" // 3. 副檔名比對：放行所有靜態資源
  ],
  "ReverseProxy": {
    "Routes": {
      "target-route": {
        "ClusterId": "target-cluster",
        "Match": {
          "Path": "/ssoproxy/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "target-cluster": {
        "Destinations": {
          "destination1": {
            // 這裡設定被保護的後端網頁實體網址 (PoC 階段可先指向任一公開或內部網頁)
            "Address": "http://my-target-web/" 
          }
        }
      }
    }
  }
}