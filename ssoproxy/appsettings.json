{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwe": {
    "Secret": "sso-development-jwe-secret-32-bytes"
  },
  "ConnectionStrings": {
    "Redis": "redis-master:6379,redis-slave:6379,password=jrlbqisuPGkF2qOP,serviceName=mymaster",
    "MSSQL": "Server=192.168.198.131;Database=sso;User Id=gauciouss;Password=1qaz@WSX;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True;"
  },
  "SsoWhitelist": [  // 【新增：SSO 免驗證白名單路徑】
    "^/target-web/health$",                 // 1. 完全比對：健康檢查端點
    "^/target-web/public/.*$",              // 2. 字首比對：所有 /public/ 底下的公開頁面
    "\\. (fx|css|js|png|jpg|jpeg|gif|ico)$" // 3. 副檔名比對：放行所有靜態資源
  ],
  "ReverseProxy": {
    "Routes": {
      "test1-route": {
        "ClusterId": "target-web1-cluster", // 這裡的 ClusterId 是指向目標 Web1 應用程式的集群名稱，請確保與 Clusters 中的名稱一致
        "Order": 100,
        "Match": {
          "Hosts": ["test1.gd.com"],
          "Path": "/{**catch-all}"
        }
      },
      "test2-route": {
        "ClusterId": "target-web2-cluster", // 這裡的 ClusterId 是指向目標 Web2 應用程式的集群名稱，請確保與 Clusters 中的名稱一致
        "Order": 100,
        "Match": {
          "Hosts": ["test2.gd.com"],
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "target-web1-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://sso-poc-target-web1/"  // 這裡的 Address 是指向目標 Web1 應用程式的內部容器名稱，請確保與 docker-compose.yml 中的服務名稱一致
          }
        }
      },
      "target-web2-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://sso-poc-target-web2/"  // 這裡的 Address 是指向目標 Web2 應用程式的內部容器名稱，請確保與 docker-compose.yml 中的服務名稱一致
          }
        }
      }
    }
  }
}